{
  "name": "@powerhousedao/service-offering",
  "description": "Service offering document models",
  "version": "1.0.0-dev.35",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerhouse-inc/service-offering.git"
  },
  "type": "module",
  "files": [
    "/dist",
    "/browser",
    "style.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/node/index.mjs"
    },
    "./document-models": {
      "types": "./dist/document-models/index.d.ts",
      "browser": "./dist/browser/document-models/index.js",
      "node": "./dist/node/document-models/index.mjs"
    },
    "./document-models/*": {
      "types": "./dist/document-models/*/index.d.ts",
      "browser": "./dist/browser/document-models/*/index.js",
      "node": "./dist/node/document-models/*/index.mjs"
    },
    "./editors": {
      "types": "./dist/editors/index.d.ts",
      "browser": "./dist/browser/editors/index.js",
      "node": "./dist/node/editors/index.mjs"
    },
    "./editors/*": {
      "types": "./dist/editors/*/index.d.ts",
      "browser": "./dist/browser/editors/*/index.js",
      "node": "./dist/node/editors/*/index.mjs"
    },
    "./subgraphs": {
      "types": "./dist/subgraphs/index.d.ts",
      "browser": "./dist/browser/subgraphs/index.js",
      "node": "./dist/node/subgraphs/index.mjs"
    },
    "./processors": {
      "types": "./dist/processors/index.d.ts",
      "browser": "./dist/browser/processors/index.js",
      "node": "./dist/node/processors/index.mjs"
    },
    "./manifest": "./dist/powerhouse.manifest.json",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --config eslint.config.js --cache --cache-strategy content",
    "lint:fix": "npm run lint -- --fix",
    "tsc": "tsc",
    "tsc:watch": "tsc --watch",
    "check-circular-imports": "npx dpdm -T ./index.ts",
    "generate": "ph-cli generate",
    "connect": "ph-cli connect",
    "build": "ph-cli build",
    "prepublishOnly": "npm run build",
    "reactor": "ph-cli reactor",
    "service": "ph-cli service",
    "vetra": "ph-cli vetra",
    "service-startup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-startup.sh",
    "service-unstartup": "bash ./node_modules/@powerhousedao/ph-cli/dist/scripts/service-unstartup.sh"
  },
  "dependencies": {
    "@powerhousedao/analytics-engine-core": "6.0.0-dev.183",
    "@powerhousedao/connect": "6.0.0-dev.183",
    "@powerhousedao/design-system": "6.0.0-dev.183",
    "@powerhousedao/document-engineering": "1.40.1",
    "@powerhousedao/reactor-browser": "6.0.0-dev.183",
    "@uiw/react-md-editor": "^4.0.11",
    "document-drive": "6.0.0-dev.109",
    "document-model": "6.0.0-dev.183",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "lucide-react": "^0.577.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-slug": "^6.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@electric-sql/pglite-tools": "0.2.20",
    "@eslint/js": "^9.38.0",
    "@powerhousedao/ph-cli": "6.0.0-dev.183",
    "@powerhousedao/reactor": "6.0.0-dev.183",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/cli": "^4.1.18",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "8.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.1"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "staging",
        "prerelease": "staging"
      },
      {
        "name": "dev",
        "prerelease": "dev"
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "ci",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "bugs": {
    "url": "https://github.com/powerhouse-inc/service-offering/issues"
  },
  "homepage": "https://github.com/powerhouse-inc/service-offering#readme",
  "readme": "ERROR: No README data found!",
  "_id": "@powerhousedao/service-offering@1.0.0-dev.34"
}
