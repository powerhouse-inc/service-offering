    {
      "id": "debt-text",
      "type": "text",
      "x": 95,
      "y": 380,
      "width": 310,
      "height": 180,
      "text": "totalDebt (charges increase this)\n─────────────────────────\nBA-5: Activation\n  setup + recurring costs\n\nD-1: Mid-cycle group ADD\n  calculateProratedCost → debit\n\nD-4: Settlement overage\n  calculateOverageCost per metric\n\nD-4/D-9: Next cycle recurring\n  if autoRenew or manual renew\n\nMetric reset: overage before reset",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 311,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "containerId": "debt-box",
      "groupIds": ["money"]
    },

    {
