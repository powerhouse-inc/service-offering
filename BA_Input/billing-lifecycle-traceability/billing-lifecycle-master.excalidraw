    },
    {
      "id": "credit-text",
      "type": "text",
      "x": 475,
      "y": 380,
      "width": 270,
      "height": 180,
      "text": "totalCredit (payments increase this)\n─────────────────────────\nD-2: Mid-cycle group REMOVE\n  calculateProratedCost → credit\n\nreportSetupPayment\n  marks paymentDate, adds to credit\n\nreportRecurringPayment\n  marks lastPaymentDate, adds credit\n\nreportOveragePayment\n  amount <= amountOwed",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
