    {
      "id": "balance-text",
      "type": "text",
      "x": 815,
      "y": 380,
      "width": 250,
      "height": 180,
      "text": "Outstanding Balance\n= totalDebt - totalCredit\n─────────────────────\nPositive → owes money (red)\nZero → paid up\nNegative → credit surplus (green)\n\nD-7: No floor. Negative carries\nforward to offset next cycle.\n\nD-8: Settlement never checks\nthis. UI concern only.\n\ncalculateAmountOwed(state)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
